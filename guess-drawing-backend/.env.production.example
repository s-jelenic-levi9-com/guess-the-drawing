# Production Environment Configuration Template
# Copy this file to .env on your EC2 instance and fill in the actual values
# These values will be provided by CloudFormation outputs

# Application
NODE_ENV=production
PORT=3000

# AWS RDS PostgreSQL (provided by CloudFormation)
DATABASE_HOST=<RDS_ENDPOINT_FROM_CLOUDFORMATION>
DATABASE_PORT=5432
DATABASE_NAME=guess_drawing
DATABASE_USER=postgres
DATABASE_PASSWORD=<GENERATED_PASSWORD>
DATABASE_SSL=true

# AWS ElastiCache Redis (provided by CloudFormation)
REDIS_HOST=<REDIS_ENDPOINT_FROM_CLOUDFORMATION>
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration (generate with: openssl rand -base64 32)
JWT_SECRET=<GENERATE_YOUR_OWN_SECRET>
JWT_REFRESH_SECRET=<GENERATE_YOUR_OWN_REFRESH_SECRET>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration (CloudFormation will provide CloudFront domain)
CORS_ORIGIN=https://<CLOUDFRONT_DOMAIN>

# Game Settings
MAX_PLAYERS_PER_ROOM=8
DEFAULT_ROUND_TIME=90
DEFAULT_ROUNDS=3
ROOM_TIMEOUT=7200000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
DRAWING_RATE_LIMIT=60
GUESS_RATE_LIMIT=5
CHAT_RATE_LIMIT=5
