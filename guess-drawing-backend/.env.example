# Environment
NODE_ENV=development

# Server
PORT=3000
WS_PORT=3001

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/guess_drawing
DB_HOST=localhost
DB_PORT=5432
DB_NAME=guess_drawing
DB_USER=user
DB_PASSWORD=password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=7d

# Game Settings
MAX_PLAYERS_PER_ROOM=8
DEFAULT_ROUND_TIME=90
DEFAULT_ROUNDS=3
ROOM_TIMEOUT=7200000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
DRAWING_RATE_LIMIT=60
GUESS_RATE_LIMIT=5
CHAT_RATE_LIMIT=5

# CORS
CORS_ORIGIN=http://localhost:4200

# Logging
LOG_LEVEL=info
